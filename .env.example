# ─────────────────────────────────────────────────────────────
# Tiles Gallery — Environment Configuration
# Copy to .env.local for local development. Set these in the
# Vercel dashboard (Project → Settings → Environment Variables) for production.
# ─────────────────────────────────────────────────────────────

# ─── Authentication (Better Auth compatible) ───
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""

# The public base URL of the deployed application.
# Production (Vercel): set to your live URL, e.g. "https://tiles-gallery.vercel.app"
# Local dev: "http://localhost:3000"
# If unset, the backend derives it from Vercel-provided headers automatically.
BETTER_AUTH_URL=""

# ─── Google OAuth (Google Cloud Console → APIs & Services → Credentials) ───
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: pin the EXACT Authorized redirect URI registered in Google Cloud Console.
# Must be: https://<your-vercel-domain>/api/auth/callback/google
GOOGLE_REDIRECT_URI=""

# ─── API ───
# Leave EMPTY for same-origin (recommended on Vercel — the Express backend runs
# as a serverless function of the same deployment, no CORS needed).
# Only set this if the backend is deployed to a separate domain.
VITE_API_URL=""
NEXT_PUBLIC_API_URL=""

# ─── CORS ───
# Comma-separated list of allowed origins for cross-origin API access.
# Leave empty to reflect any origin (safe: the API uses Bearer-token auth, not cookies).
# Example: "https://tiles-gallery.vercel.app,https://tiles-gallery.com"
CORS_ORIGINS=""

# ─── Optional integrations ───
MONGODB_URI=""
# Required for Gemini AI API calls.
GEMINI_API_KEY=""
# Legacy alias for the app URL (used by some AI Studio hosting environments).
APP_URL=""
